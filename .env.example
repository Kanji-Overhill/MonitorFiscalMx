APP_NAME="Monitor Fiscal MX"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=proveedores_sat
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Monitor Fiscal MX ------------------------------------------------------

# URL del archivo descargable (CSV) publicado oficialmente por el SAT para el
# listado del Artículo 69-B. Verificada manualmente (ver docs/zoho-open-questions.md,
# sección de fuente de datos): se descarga y se importa correctamente con
# `php artisan sat:import-69b`. El SAT puede moverla sin previo aviso, así que
# conviene revisarla periódicamente contra
# https://www.sat.gob.mx/minisitio/DatosAbiertos/contribuyentes_publicados.html
SAT_69B_SOURCE_URL="https://wu1agsprosta001.blob.core.windows.net/agsc-publicaciones/Datos_abiertos/Documents_AGAFF/Listado_completo_69-B.csv"

# Página informativa oficial que se muestra al usuario como "fuente oficial".
SAT_69B_OFFICIAL_URL="https://www.sat.gob.mx/consultas/informacion-del-articulo-69-b-del-codigo-fiscal-de-la-federacion"

SAT_69B_DOWNLOAD_TIMEOUT=60

# Endpoint HTTP opcional de importación (deshabilitado por defecto).
# Preferir el comando de consola `sat:import-69b`.
SAT_IMPORT_ENDPOINT_ENABLED=false
SAT_IMPORT_ENDPOINT_SECRET=

# Orígenes permitidos por CORS para pruebas locales del widget (zet run).
# En producción las llamadas del widget pasan por "API Configurations" de
# Zoho (server-to-server) y no dependen de esta lista.
CORS_ALLOWED_ORIGINS=https://127.0.0.1:5000
